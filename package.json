{
  "name": "lodestar",
  "productName": "Lodestar",
  "version": "0.1.0",
  "description": "A fast, beautiful, Steam-style launcher for your Epic Games library.",
  "main": "./out/main/index.js",
  "author": "Lodestar contributors",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:win": "electron-vite build && electron-builder --win nsis",
    "dist:store": "electron-vite build && electron-builder --win appx",
    "dist:mac": "electron-vite build && electron-builder --mac dmg",
    "dev:web": "vite --config vite.web.config.ts",
    "test": "node --test src/main/providers/epic/integrity.test.cjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "5.9",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ErzenXz/lodestar.git"
  },
  "homepage": "https://github.com/ErzenXz/lodestar",
  "private": true
}
