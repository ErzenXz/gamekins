{
  "name": "gamekins",
  "productName": "Gamekins",
  "version": "0.1.1",
  "description": "A fast, beautiful, Steam-style launcher for your Epic Games library.",
  "main": "./out/main/index.js",
  "author": "Gamekins contributors",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:win": "node scripts/release.cjs win",
    "dist:store": "node scripts/release.cjs store",
    "dist:mac": "node scripts/release.cjs mac",
    "dev:web": "vite --config vite.web.config.ts",
    "test": "node --test src/main/providers/epic/integrity.test.cjs src/main/providers/epic/social.test.cjs src/main/core/socialHub.test.cjs src/main/providers/gog/gog.test.cjs src/main/providers/steam/steam.test.cjs",
    "dist:linux": "node scripts/release.cjs linux",
    "test:renderer": "node --test src/renderer/tests/batch-d.test.cjs",
    "test:release": "node --test scripts/release.test.cjs",
    "check": "pnpm typecheck && pnpm test && pnpm test:renderer && pnpm test:credentials && pnpm test:platform && pnpm test:release && pnpm test:content",
    "test:credentials": "node --test src/main/core/credentials.test.cjs",
    "test:platform": "node --test src/main/core/platform.test.cjs",
    "test:content": "node --test src/shared/contentPolicy.test.cjs src/main/core/external.test.cjs src/renderer/tests/social-safety.test.cjs src/main/core/authWindowSafety.test.cjs"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "lucide-react": "1.51.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ErzenXz/gamekins.git"
  },
  "homepage": "https://github.com/ErzenXz/gamekins",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12.14.0 <13"
  }
}
